import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner s= new Scanner(System.in);
        int N = s.nextInt();

        int[] original = new int[N];
        for (int i = 0; i < N; i++) {
            original[i] = s.nextInt();
        }
        int[] copied = new int[N];

    
        for (int i = 0; i < N; i++) {
            copied[i] = original[i];
        }
        for (int i = 0; i < N; i++) {
            System.out.print(copied[i] + " ");
        }

    }
}


